# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the browser.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap,
# RSS, email links and Supabase auth redirects.
# Local: http://localhost:3000 · Production: https://filingedge360.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API Keys) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...). The legacy "service_role" key also works.
# SERVER ONLY — bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Resend (resend.com → API Keys) ──────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="Filingedge360 <noreply@filingedge360.com>"
# Where customer replies should go (optional).
EMAIL_REPLY_TO=support@filingedge360.com
# Comma-separated list of team inboxes that get an alert for every new lead.
LEAD_NOTIFY_EMAILS=support@filingedge360.com
# Inboxes alerted for every job application. Falls back to LEAD_NOTIFY_EMAILS.
CAREERS_NOTIFY_EMAILS=hr@filingedge360.com

# ── Security ────────────────────────────────────────────────────────────
# Required in production. Random secret used to hash visitor IPs for rate limiting
# (no raw IPs are stored). Local dev falls back to a known value if this is empty.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
# Protects /api/cron/* (Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
# Generate the same way as IP_HASH_SALT.
CRON_SECRET=

# ── Analytics & ads (all optional) ──────────────────────────────────────
# Nothing loads until the visitor accepts cookies in the banner; the banner
# only appears once at least one of these is set. If you use GTM, configure
# GA4 / Ads / Pixel inside GTM and leave their individual IDs empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for the "lead" conversion action (AW-XXXX/<label>).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Search engine verification (optional) ──────────────────────────────
# The content value of the meta tag each console gives you.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
